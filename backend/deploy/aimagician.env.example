# Copy to an ignored local path such as:
#   ~/.config/aimagician/aimagician.env
# or:
#   aimagician/backend/.env
#
# Never commit the filled file.

AIMAGICIAN_APP_ENV=production
AIMAGICIAN_DATABASE_URL=postgresql+psycopg://aimagician:CHANGE_ME@127.0.0.1:5432/aimagician
AIMAGICIAN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AIMAGICIAN_COOKIE_NAME=aimagician_session
AIMAGICIAN_COOKIE_SECURE=false
AIMAGICIAN_COOKIE_SAMESITE=lax
AIMAGICIAN_SESSION_TTL_SECONDS=28800
AIMAGICIAN_ENABLE_DOCS=false
AIMAGICIAN_ARTIFACT_ROOT=/var/lib/aimagician/artifacts
AIMAGICIAN_STRICT_API_NATIVE=true

# Used by `bin/aimagician-backend bootstrap-admin`.
AIMAGICIAN_ADMIN_EMAIL=admin@example.com
AIMAGICIAN_ADMIN_DISPLAY_NAME=AImagician Admin
AIMAGICIAN_ADMIN_PASSWORD=replace-with-a-local-admin-password

# Optional credential upload and encryption settings.
AIMAGICIAN_CREDENTIAL_UPLOAD_TOKEN_HASH=
AIMAGICIAN_CREDENTIAL_ENCRYPTION_KEY=

# Server wrapper defaults.
AIMAGICIAN_HOST=127.0.0.1
AIMAGICIAN_PORT=8765
AIMAGICIAN_WORKER_ID=aimagician-worker-1
AIMAGICIAN_WORKER_POLL_INTERVAL_SECONDS=5

# Optional deep research provider keys used by backend worker jobs.
# Multiple keys are comma-separated; never commit filled values.
OPENCLAW_DEEP_RESEARCH_PROVIDER=auto
OPENCLAW_DEEP_RESEARCH_TIMEOUT_SECONDS=900
TAVILY_API_KEYS=
TAVILY_API_KEY_FALLBACK=
BRAVE_SEARCH_API_KEYS=
SEARXNG_BASE_URL=

# Optional OpenAI-compatible LLM endpoint used by backend-native article jobs.
# Keep real keys in the ignored runtime env file only.
AIMAGICIAN_LLM_BASE_URL=
AIMAGICIAN_LLM_MODEL=agnes-2.5-flash
AIMAGICIAN_LLM_API_KEY=
AIMAGICIAN_LLM_TIMEOUT_SECONDS=1200
AIMAGICIAN_LLM_BODY_CHUNK_WORDS=1000
