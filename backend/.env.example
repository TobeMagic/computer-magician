AIMAGICIAN_APP_ENV=local
AIMAGICIAN_DATABASE_URL=postgresql+psycopg://aimagician:aimagician@127.0.0.1:5432/aimagician
AIMAGICIAN_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AIMAGICIAN_COOKIE_NAME=aimagician_session
AIMAGICIAN_COOKIE_SECURE=false
AIMAGICIAN_COOKIE_SAMESITE=lax
AIMAGICIAN_SESSION_TTL_SECONDS=28800
AIMAGICIAN_ADMIN_EMAIL=admin@example.com
AIMAGICIAN_ADMIN_DISPLAY_NAME=AImagician Admin
# Prefer passing the initial password through a shell secret manager.
# AIMAGICIAN_ADMIN_PASSWORD=
# Optional credential upload and encryption boundary.
# AIMAGICIAN_CREDENTIAL_UPLOAD_TOKEN_HASH=
# AIMAGICIAN_CREDENTIAL_ENCRYPTION_KEY=

# Live article jobs must use backend-native handlers and MCP/API surfaces.
# Missing native handlers fail with native_handler_missing.
AIMAGICIAN_STRICT_API_NATIVE=true

# Backend-owned asset roots. The reaction library is large and should be mounted
# into the backend runtime, not read from legacy OpenClaw skill directories.
# Defaults to ${AIMAGICIAN_ARTIFACT_ROOT}/assets/reaction-library when empty.
# AIMAGICIAN_ARTIFACT_ROOT=/tmp/aimagician-artifacts
# AIMAGICIAN_REACTION_LIBRARY_ROOT=
# AIMAGICIAN_BROWSER_RUNNER_ROOT=../browser-runners
# AIMAGICIAN_BROWSER_STATE_ROOT=/tmp/aimagician-artifacts/browser-states

# Public brand shown on covers, cards, and distribution footers.
# AIMAGICIAN_BRAND_NAME=计算机魔术师
# AIMAGICIAN_WECHAT_ACCOUNT_NAME=
# AIMAGICIAN_WECHAT_PROFILE_ID=
# AIMAGICIAN_WECHAT_BIZ=
# AIMAGICIAN_ENDCARD_PATH=
# AIMAGICIAN_HEXO_BASE_URL=
# AIMAGICIAN_HEXO_REPO_DIR=

# Native Notion writer.
# AIMAGICIAN_NOTION_TOKEN=
# AIMAGICIAN_NOTION_ARTICLES_DATABASE_ID=

# Native publisher/health provider endpoints. Prefer platform-specific endpoints.
# AIMAGICIAN_NATIVE_PUBLISHER_HEXO_URL=
# AIMAGICIAN_NATIVE_PUBLISHER_WECHAT_URL=
# AIMAGICIAN_NATIVE_PUBLISHER_CSDN_URL=
# AIMAGICIAN_NATIVE_PUBLISHER_JUEJIN_URL=
# AIMAGICIAN_NATIVE_PUBLISHER_ZHIHU_URL=
# AIMAGICIAN_NATIVE_PUBLISHER_INFOQ_URL=
# AIMAGICIAN_NATIVE_HEALTH_INFOQ_URL=
# AIMAGICIAN_NATIVE_HEALTH_ZHIHU_URL=
# AIMAGICIAN_NATIVE_HEALTH_JUEJIN_URL=

# Backend-native article generation. Real keys belong in ignored runtime env files.
# AIMAGICIAN_LLM_BASE_URL=https://aihubmix.com
# AIMAGICIAN_LLM_MODEL=minimax-m2.7
# AIMAGICIAN_LLM_API_KEY=
# AIMAGICIAN_LLM_TIMEOUT_SECONDS=1200
# AIMAGICIAN_LLM_BODY_CHUNK_WORDS=1000
